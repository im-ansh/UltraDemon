# Environment variables for UltraSearch API
# Copy this file to .env and fill in your values

# ── Server ──────────────────────────────────────────────────────────────────
ULTRASEARCH_HOST=0.0.0.0
ULTRASEARCH_PORT=8000
ULTRASEARCH_WORKERS=4
ULTRASEARCH_LOG_LEVEL=info

# ── Security ─────────────────────────────────────────────────────────────────
# CHANGE THIS in production! Used to sign API keys.
ULTRASEARCH_SECRET=change-me-to-a-long-random-secret-min-32-chars

# ── Your UltraSearch API key (for MCP server self-auth) ───────────────────────
ULTRASEARCH_API_KEY=us_your_key_here

# ── Search Backend API Keys (add at least one) ────────────────────────────────
# Brave Search — https://api.search.brave.com/  (fastest, independent index)
BRAVE_API_KEY=

# Serper — https://serper.dev/  (Google results, very cheap)
SERPER_API_KEY=

# Exa — https://exa.ai/  (semantic/neural search)
EXA_API_KEY=

# Tavily — https://tavily.com/  (AI-native, great for RAG)
TAVILY_API_KEY=

# ── Cache ─────────────────────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379/0
CACHE_TTL_SECONDS=60

# ── Timeouts ──────────────────────────────────────────────────────────────────
# Max ms to wait for each backend before skipping it
BACKEND_TIMEOUT_MS=800

