{
  "name": "ultrasearch-cloudflare",
  "version": "1.0.0",
  "description": "UltraSearch API — Cloudflare Workers edge deployment",
  "private": true,
  "scripts": {
    "dev":        "wrangler dev",
    "deploy":     "wrangler deploy",
