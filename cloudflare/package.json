{
  "name": "ultrasearch-cloudflare",
  "version": "1.0.0",
  "description": "UltraSearch API — Cloudflare Workers edge deployment",
  "private": true,
  "scripts": {
    "dev":     "wrangler dev",
    "deploy":  "wrangler deploy",
    "db:migrate": "wrangler d1 migrations apply ultrasearch-db",
    "db:local":   "wrangler d1 migrations apply ultrasearch-db --local",
    "tail":    "wrangler tail",
    "types":   "wrangler types"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241022.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.80.0"
  }
}
