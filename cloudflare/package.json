    "types":      "wrangler types"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20261101.1",
    "typescript": "^5.6.0",
    "wrangler": "^4.156.0"
  }
}
